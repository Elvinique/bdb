# Engr. Buradum Baribefe Daniel Campaign Platform - Environment Variables

# App Configuration
PORT=3000
NODE_ENV=development
VITE_APP_TITLE="Nigeria Federal House Campaign Platform"
VITE_APP_URL="http://localhost:3000"

# Google Gemini AI Integration (Beacon AI Chatbot)
GEMINI_API_KEY=

# Supabase Credentials (PostgreSQL, Auth & Storage)
# Leave empty to operate in local simulated database mode
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Campaign Fundraising & Payment Provider (Paystack / Flutterwave Sandbox)
# Stays disabled in production until compliance sign-off (PRD Section 18 & 52)
VITE_FUNDRAISING_ENABLED=true
PAYMENT_PROVIDER=paystack_sandbox
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Email / Notifications (Resend or SMTP)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=campaign@buradumforhouse.ng
ADMIN_NOTIFICATION_EMAIL=admin@buradumforhouse.ng
